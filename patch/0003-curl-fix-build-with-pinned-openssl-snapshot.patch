From fd087b07dbdd6ceb46b2afe2f76e2a1582c0d13e Mon Sep 17 00:00:00 2001
From: the-database <25811902+the-database@users.noreply.github.com>
Date: Tue, 6 Oct 2026 00:37:32 +0000
Subject: [PATCH] curl: fix build with the pinned OpenSSL 4.1 snapshot

curl 978cce12a calls ASN1_STRING_get_length() whenever OpenSSL reports 4.1, but the pinned OpenSSL snapshot (d8bf6cdd) predates that function. Route the calls through a local wrapper instead.
---
 ...build-with-pre-release-4.1-snapshots.patch | 35 +++++++++++++++++++
 1 file changed, 35 insertions(+)
 create mode 100644 packages/curl-0002-openssl-build-with-pre-release-4.1-snapshots.patch

diff --git a/packages/curl-0002-openssl-build-with-pre-release-4.1-snapshots.patch b/packages/curl-0002-openssl-build-with-pre-release-4.1-snapshots.patch
new file mode 100644
index 0000000..cf823eb
--- /dev/null
+++ b/packages/curl-0002-openssl-build-with-pre-release-4.1-snapshots.patch
@@ -0,0 +1,35 @@
+From cb8471cdbee39a18b46cb807e4c495dd81768217 Mon Sep 17 00:00:00 2001
+From: the-database <25811902+the-database@users.noreply.github.com>
+Date: Tue, 6 Oct 2026 00:33:58 +0000
+Subject: [PATCH] openssl: build with pre-release OpenSSL 4.1 snapshots
+
+---
+ lib/vtls/openssl.c | 8 +++++---
+ 1 file changed, 5 insertions(+), 3 deletions(-)
+
+diff --git a/lib/vtls/openssl.c b/lib/vtls/openssl.c
+index 3183d1097..6679795bf 100644
+--- a/lib/vtls/openssl.c
++++ b/lib/vtls/openssl.c
+@@ -172,13 +172,15 @@ typedef unsigned long sslerr_t;
+ #endif
+ #define ossl_valsize_t numcert_t
+ 
+-#if OPENSSL_VERSION_NUMBER < 0x40100000L
+-static size_t ASN1_STRING_get_length(const ASN1_STRING *str)
++/* Pre-release OpenSSL 4.1 snapshots report 4.1 but predate
++   ASN1_STRING_get_length(), so always use our own wrapper. */
++static size_t ossl_asn1_string_length(const ASN1_STRING *str)
+ {
+    const int length = ASN1_STRING_length(str);
+    return length >= 0 ? (size_t)length : 0;
+ }
+-#endif
++#undef ASN1_STRING_get_length
++#define ASN1_STRING_get_length(s) ossl_asn1_string_length(s)
+ 
+ static CURLcode push_certinfo(struct Curl_easy *data,
+                               BIO *mem, const char *label, int num)
+-- 
+2.43.0
+
-- 
2.43.0

